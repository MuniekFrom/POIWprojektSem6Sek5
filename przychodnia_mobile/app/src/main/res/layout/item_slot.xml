<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSlotId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/slot_id_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            tools:text="ID slotu: 2"/>

        <TextView
            android:id="@+id/tvSlotDoctor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/slot_doctor_label"
            android:textSize="13sp"
            android:textColor="@color/text_main"
            tools:text="Lekarz: Jan Kowalski"/>

        <TextView
            android:id="@+id/tvSlotSpecialization"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/slot_specialization_label"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            tools:text="Specjalizacja: Kardiolog"/>

        <TextView
            android:id="@+id/tvSlotStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/slot_start_label"
            android:textSize="13sp"
            android:textColor="@color/text_main"
            tools:text="Start: 01.12.2026, 10:00"/>

        <TextView
            android:id="@+id/tvSlotEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/slot_end_label"
            android:textSize="13sp"
            android:textColor="@color/text_main"
            tools:text="Koniec: 01.12.2026, 10:30"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_status_label"
                android:textSize="13sp"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/tvSlotStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_slots_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/slot_available"
                android:textColor="@color/green_text_slots"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etVisitReason"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_edittext"
            android:hint="@string/visit_reason_hint"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:inputType="text"
            android:importantForAutofill="no" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBookSlot"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@color/primary_blue"
            android:text="@string/book_slot"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
