<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Force light mode colors even in dark mode -->
    <style name="Base.Theme.Przychodnia_mobile" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal_700</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorSurfaceVariant">@color/white</item>
    </style>
</resources>